{
  "review_app": {
    "entry": "",
    "real_entry": "",
    "node_executable": "",
    "sha256": "4c306c3d94341ff2e8d43ab0212e7cf996d6faf0cff54814c57c22e4c6838813"
  },
  "github_login": "<YOUR_GITHUB_LOGIN>",
  "repos": [
    "sgl-project/sglang"
  ],
  "mode": "shadow",
  "sources": {
    "slack": {
      "enabled": true,
      "poll_seconds": 120,
      "lookback_days": 14,
      "review_max_age_days": 14,
      "watch_max_age_days": 3,
      "watch_channels": [
        "pull-requests"
      ]
    },
    "slack_inbox": {
      "enabled": true,
      "poll_seconds": 300,
      "lookback_days": 14
    },
    "github_mentions": {
      "enabled": true,
      "poll_seconds": 600,
      "lookback_days": 3
    },
    "github_assigned": {
      "enabled": true,
      "poll_seconds": 600,
      "lookback_days": 7
    },
    "github_review_requested": {
      "enabled": false
    }
  },
  "agent": {
    "runner": "codex",
    "codex_homes": [
      "<PATH_TO_CODEX_HOME_1>",
      "<PATH_TO_CODEX_HOME_2>"
    ],
    "max_concurrent": 4,
    "daily_review_limit": 100,
    "windows": [
      "10:00",
      "15:00",
      "21:00"
    ],
    "window_minutes": 120,
    "daily_token_budget": 8000000,
    "token_reserve": 150000,
    "service_tier": "",
    "profiles": {
      "T1": {
        "model": "<CODEX_MODEL>",
        "effort": "medium"
      },
      "T2": {
        "model": "<CODEX_MODEL>",
        "effort": "high"
      },
      "T3": {
        "model": "<CODEX_MODEL_STRONGEST>",
        "effort": "xhigh"
      },
      "verify": {
        "model": "<CODEX_MODEL>",
        "effort": "medium"
      },
      "ci": {
        "model": "<CODEX_MODEL>",
        "effort": "medium"
      },
      "fix": {
        "model": "<CODEX_MODEL>",
        "effort": "high"
      },
      "discuss": {
        "model": "<CODEX_MODEL>",
        "effort": "high"
      },
      "translate": {
        "model": "<CODEX_MODEL>",
        "effort": "low"
      }
    }
  },
  "policy": {
    "auto_ci": true,
    "auto_targeted_tests": true,
    "auto_retry_failed_ci": true,
    "auto_publish_findings": true,
    "auto_author_notes": true,
    "auto_discuss": true,
    "auto_approve": true,
    "auto_approve_tiers": [
      "T1",
      "T2"
    ],
    "max_auto_approvals_per_day": 30,
    "auto_merge": false,
    "max_auto_merges_per_day": 10,
    "min_merge_interval_minutes": 60,
    "auto_fix": false,
    "max_agent_fixes_per_pr": 2,
    "max_agent_fixes_per_day": 20,
    "min_fix_interval_minutes": 15,
    "slack_report": true,
    "slack_prefix": "[{login} Review Agent] ",
    "github_prefix": "[{login} Review Agent] ",
    "slack_outcomes": [
      "approved",
      "changes",
      "bounce",
      "ci_related",
      "merged"
    ],
    "require_test_plan": false
  },
  "notify_macos": true
}
